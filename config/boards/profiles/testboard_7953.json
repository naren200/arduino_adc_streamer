{
  "schema_version": 1,
  "profile_version": 3,
  "id": "testboard_7953",
  "mcu_aliases": [
    "TestBoard_7953",
    "PCB_TestBoard_7953"
  ],
  "provenance": {
    "source": "Arduino_Sketches/TestBoard_7953/",
    "verified_against": "Repository firmware and host compatibility tests"
  },
  "default_mode": "PZT",
  "hardware": {
    "adc_resolution_bits": 12,
    "adc_lane_count": 4,
    "inputs_per_adc": 16,
    "max_arrays": 2,
    "reserved_inputs": {
      "vmid": 15
    },
    "lane_label": "ADC"
  },
  "transport": {
    "baud_rate": 460800,
    "command_terminator": "***",
    "run_ack": "none",
    "bootstrap": "shared_usb"
  },
  "preferences": {
    "reconnect": "defaults"
  },
  "sensor_requirements": {
    "placements": [
      "B",
      "L",
      "C",
      "R",
      "T"
    ]
  },
  "sensor_editability": {
    "electrical": true,
    "spatial": true
  },
  "modes": {
    "PZT": {
      "device_mode": "adc",
      "features": {
        "is_array_pzt_pzr17": false,
        "is_teensy": false,
        "yaxis_units_locked": false,
        "yaxis_units_value": null,
        "show_charge_discharge_labels": false,
        "show_manual_channels": false,
        "device_mode_log_label": "ADC streamer"
      },
      "parameters": {
        "reference": {
          "type": "enum",
          "default": "2.5",
          "label": "Voltage Reference:",
          "policy": "editable",
          "section": "adc",
          "choices": [
            {
              "id": "2.5",
              "label": "2.5 V",
              "wire_value": "2.5",
              "full_scale_volts": 2.5
            },
            {
              "id": "5",
              "label": "5 V",
              "wire_value": "5",
              "full_scale_volts": 5.0,
              "aliases": [
                "5.0"
              ]
            }
          ],
          "command": "ref"
        },
        "vmid_sampling": {
          "type": "boolean",
          "default": false,
          "label": "Use Vmid Sample",
          "policy": "editable",
          "section": "acquisition",
          "legacy_key": "use_ground",
          "command": "vmid"
        },
        "samples_per_channel": {
          "type": "integer",
          "default": 1,
          "label": "Repeat Count:",
          "policy": "fixed",
          "section": "acquisition",
          "legacy_key": "repeat",
          "minimum": 1,
          "maximum": 16
        },
        "sweeps_per_block": {
          "type": "integer",
          "default": 1,
          "label": "Sweeps per Block:",
          "policy": "fixed",
          "section": "acquisition",
          "minimum": 1,
          "maximum": 10000
        },
        "spi_clock_hz": {
          "type": "integer",
          "default": 20000000,
          "label": "SPI CLK [MHz]:",
          "policy": "editable",
          "section": "adc",
          "display_scale": 1e-06,
          "display_unit": "MHz",
          "decimals": 3,
          "step": 100000,
          "tooltip": "Requested SPI clock; values above 20 MHz are experimental",
          "legacy_key": "testboard_spi_clock_hz",
          "minimum": 100000,
          "maximum": 30000000,
          "command": "spiclock"
        },
        "settling_conversions": {
          "type": "integer",
          "default": 1,
          "label": "Repeat Count:",
          "policy": "editable",
          "section": "acquisition",
          "tooltip": "Settling conversions per channel; only the final result is retained",
          "legacy_key": "testboard_channel_repeat",
          "minimum": 1,
          "maximum": 3,
          "command": "channelrepeat"
        },
        "sequence": {
          "type": "enum",
          "default": "manual",
          "label": "Sequence:",
          "policy": "editable",
          "section": "acquisition",
          "legacy_key": "testboard_sequence",
          "choices": [
            {
              "id": "manual",
              "label": "manual",
              "wire_value": "manual"
            },
            {
              "id": "auto1",
              "label": "auto1",
              "wire_value": "auto1"
            }
          ],
          "command": "adcseq"
        },
        "array_selection": {
          "type": "enum",
          "default": "both",
          "label": "Array:",
          "policy": "editable",
          "section": "acquisition",
          "legacy_key": "testboard_array_selection",
          "choices": [
            {
              "id": "both",
              "label": "Both arrays",
              "wire_value": "both"
            },
            {
              "id": "1",
              "label": "Array 1",
              "wire_value": "1"
            },
            {
              "id": "2",
              "label": "Array 2",
              "wire_value": "2"
            }
          ],
          "command": "array"
        },
        "scan_order": {
          "type": "enum",
          "default": "adc",
          "label": "Scan order:",
          "policy": "config_file_only",
          "section": "acquisition",
          "legacy_key": "testboard_scan_order",
          "choices": [
            {
              "id": "adc",
              "label": "adc",
              "wire_value": "adc"
            },
            {
              "id": "array",
              "label": "array",
              "wire_value": "array"
            },
            {
              "id": "interleaved",
              "label": "interleaved",
              "wire_value": "interleaved"
            }
          ],
          "command": "scanorder"
        }
      },
      "scaling": {
        "units": "adc_counts"
      },
      "adapters": {
        "protocol": "profile_commands",
        "frame": "ads7953_u16_timed",
        "acquisition": "multi_array",
        "timing": "unavailable"
      },
      "rules": [
        {
          "when": {
            "parameter": "vmid_sampling",
            "equals": true
          },
          "force": {
            "sequence": "manual"
          },
          "enabled": {
            "sequence": false
          }
        },
        {
          "when": {
            "parameter": "sequence",
            "equals": "auto1"
          },
          "effective": {
            "settling_conversions": 1
          },
          "enabled": {
            "settling_conversions": false
          }
        }
      ],
      "buffer_limits": {},
      "emitted_adc_lanes": 4,
      "streaming": {
        "pipeline": "batched_timed_sweeps",
        "render_interval_ms": 200
      },
      "configuration": {
        "acknowledgement": "bare",
        "commands": [
          {
            "command": "mode",
            "value": {
              "source": "mode"
            }
          },
          {
            "parameter": "reference"
          },
          {
            "parameter": "spi_clock_hz"
          },
          {
            "parameter": "array_selection"
          },
          {
            "parameter": "scan_order"
          },
          {
            "command": "adcchannels",
            "value": {
              "source": "configured_routes"
            }
          },
          {
            "parameter": "settling_conversions"
          },
          {
            "parameter": "vmid_sampling"
          },
          {
            "parameter": "sequence"
          }
        ],
        "status": {
          "command": "status",
          "start": {
            "contains": "STATUS (PZT/ADS7953)"
          },
          "end": {
            "prefix": "# ---",
            "exclude": "STATUS"
          },
          "retain_unknown": false,
          "fields": {
            "array": {
              "type": "text",
              "target": "testboard_array",
              "expected": {
                "parameter": "array_selection"
              }
            },
            "scanorder": {
              "type": "text",
              "target": "testboard_scan_order",
              "expected": {
                "parameter": "scan_order"
              }
            },
            "spi_clock_hz": {
              "type": "integer",
              "target": "testboard_spi_clock_hz",
              "expected": {
                "parameter": "spi_clock_hz"
              }
            },
            "route_count": {
              "type": "integer",
              "target": "testboard_route_count",
              "expected": {
                "source": "route_count"
              }
            },
            "vref": {
              "type": "parameter",
              "target": "reference",
              "parameter": "reference",
              "expected": {
                "parameter": "reference"
              }
            },
            "adcchannels": {
              "type": "routes",
              "target": "testboard_routes",
              "comparison": "canonical_routes",
              "expected": {
                "source": "configured_routes"
              }
            },
            "adcseq": {
              "type": "text",
              "target": "testboard_sequence",
              "expected": {
                "parameter": "sequence"
              }
            },
            "channelrepeat_requested": {
              "type": "integer",
              "target": "testboard_channel_repeat",
              "expected": {
                "parameter": "settling_conversions"
              }
            },
            "channelrepeat_effective": {
              "type": "integer",
              "target": "testboard_effective_repeat",
              "expected": {
                "parameter": "settling_conversions",
                "setting": "effective"
              }
            },
            "vmid_channel": {
              "type": "integer",
              "target": "ground_pin",
              "expected": {
                "source": "vmid_channel"
              }
            },
            "vmid_between_channels_requested": {
              "type": "boolean",
              "target": "testboard_vmid",
              "expected": {
                "parameter": "vmid_sampling"
              }
            },
            "vmid_between_channels_effective": {
              "type": "boolean",
              "target": "testboard_effective_vmid",
              "expected": {
                "parameter": "vmid_sampling",
                "setting": "effective"
              }
            },
            "spiengine": {
              "type": "text",
              "target": "testboard_engine",
              "required": true,
              "choices": [
                "blocking",
                "dma",
                "lpspi"
              ]
            },
            "sampling_sweeps": {
              "type": "integer",
              "target": "stream_diagnostics.sampling_sweeps"
            },
            "usb_frames_sent": {
              "type": "integer",
              "target": "stream_diagnostics.usb_frames_sent"
            },
            "usb_frames_discarded": {
              "type": "integer",
              "target": "stream_diagnostics.usb_frames_discarded"
            },
            "sampling_period_max_us": {
              "type": "integer",
              "target": "stream_diagnostics.sampling_period_max_us"
            },
            "sampling_period_over_1ms": {
              "type": "integer",
              "target": "stream_diagnostics.sampling_period_over_1ms"
            }
          }
        },
        "capture_engine_field": "testboard_engine"
      }
    }
  }
}
