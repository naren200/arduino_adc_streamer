{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adc-streamer:board-profile:1",
  "title": "ADC Streamer board profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_version", "id", "mcu_aliases", "provenance", "default_mode", "hardware", "transport", "modes"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_version": {"type": "integer", "minimum": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "mcu_aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "object", "required": ["source"], "properties": {"source": {"type": "string"}}},
    "default_mode": {"type": "string", "minLength": 1},
    "hardware": {
      "type": "object", "additionalProperties": false,
      "required": ["adc_resolution_bits", "adc_lane_count", "inputs_per_adc", "max_arrays", "reserved_inputs"],
      "properties": {
        "adc_resolution_bits": {"type": "integer", "minimum": 1, "maximum": 16},
        "adc_lane_count": {"type": "integer", "minimum": 1},
        "inputs_per_adc": {"type": "integer", "minimum": 1},
        "max_arrays": {"type": "integer", "minimum": 1},
        "lane_label": {"type": "string"},
        "unavailable_inputs": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "route_encoding": {"type": "object", "additionalProperties": false, "required": ["inputs_per_mux"], "properties": {"inputs_per_mux": {"type": "integer", "minimum": 1}}},
        "reserved_inputs": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["baud_rate", "command_terminator", "run_ack", "bootstrap"],
      "properties": {
        "baud_rate": {"type": "integer", "minimum": 1},
        "command_terminator": {"type": "string", "minLength": 1},
        "run_ack": {"enum": ["none", "legacy"]},
        "bootstrap": {"const": "shared_usb"}
      }
    },
    "preferences": {"type": "object", "properties": {"reconnect": {"enum": ["defaults", "preserve"]}}},
    "sensor_requirements": {"type": "object", "properties": {"placements": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "sensor_editability": {"type": "object", "additionalProperties": false, "properties": {"electrical": {"type": "boolean"}, "spatial": {"type": "boolean"}}},
    "variants": {"type": "object", "additionalProperties": {"type": "object"}},
    "modes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/mode"}}
  },
  "$defs": {
    "mode": {
      "type": "object", "additionalProperties": false,
      "required": ["device_mode", "emitted_adc_lanes", "features", "parameters", "scaling", "adapters", "rules"],
      "properties": {
        "device_mode": {"enum": ["adc", "555"]},
        "emitted_adc_lanes": {"type": "integer", "minimum": 1},
        "features": {"type": "object"},
        "parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/parameter"}},
        "scaling": {"type": "object", "required": ["units"], "properties": {"full_scale_volts": {"type": "number", "exclusiveMinimum": 0}, "units": {"type": "string"}, "legacy_references": {"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": 0}}, "unknown_reference": {"const": "default"}}},
        "adapters": {
          "type": "object", "additionalProperties": false,
          "required": ["protocol", "frame", "acquisition", "timing"],
          "properties": {
            "protocol": {"enum": ["legacy_adc", "legacy_555", "array_dual", "profile_commands"]},
            "frame": {"enum": ["adc_u16_timed", "timer_555", "pzt_rs_u16", "ads7953_u16_timed"]},
            "acquisition": {"enum": ["channels", "array_mux", "array_combined", "multi_array"]},
            "timing": {"enum": ["unavailable", "mg24_mux", "reported"]}
          }
        },
        "configuration": {"$ref": "#/$defs/configuration"},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
        "timing_profile": {"type": "string", "minLength": 1},
        "buffer_limits": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "timing": {"type": "object"},
        "streaming": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "pipeline": {"enum": ["legacy_blocks", "batched_timed_sweeps"]},
            "render_interval_ms": {"type": "integer", "minimum": 1, "maximum": 1000}
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acknowledgement": {
          "enum": [
            "bare",
            "echo"
          ]
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "parameter": {
                    "type": "string"
                  }
                },
                "required": [
                  "parameter"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "command": {
                    "type": "string"
                  },
                  "value": {
                    "$ref": "#/$defs/configurationValue"
                  }
                },
                "required": [
                  "command",
                  "value"
                ]
              }
            ]
          }
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/statusMarker"
            },
            "end": {
              "$ref": "#/$defs/statusMarker"
            },
            "retain_unknown": {
              "type": "boolean"
            },
            "fields": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/$defs/statusField"
              }
            }
          },
          "required": [
            "command",
            "start",
            "end",
            "fields"
          ]
        },
        "capture_engine_field": {
          "type": "string"
        }
      },
      "required": [
        "acknowledgement",
        "commands",
        "status"
      ]
    },
    "configurationValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "literal": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "required": [
            "literal"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parameter": {
              "type": "string"
            },
            "setting": {
              "enum": [
                "requested",
                "effective"
              ]
            },
            "wire": {
              "type": "boolean"
            }
          },
          "required": [
            "parameter"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "mode",
                "configured_routes",
                "payload_routes",
                "route_count",
                "vmid_channel"
              ]
            }
          },
          "required": [
            "source"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "when": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "parameter": {
                  "type": "string"
                },
                "equals": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              },
              "required": [
                "parameter",
                "equals"
              ]
            },
            "then": {
              "$ref": "#/$defs/configurationValue"
            },
            "else": {
              "$ref": "#/$defs/configurationValue"
            }
          },
          "required": [
            "when",
            "then",
            "else"
          ]
        }
      ]
    },
    "statusMarker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": {
          "type": "string",
          "minLength": 1
        },
        "contains": {
          "type": "string",
          "minLength": 1
        },
        "exclude": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "prefix"
          ]
        },
        {
          "required": [
            "contains"
          ]
        }
      ]
    },
    "statusField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "text",
            "integer",
            "boolean",
            "parameter",
            "routes"
          ]
        },
        "target": {
          "type": "string"
        },
        "also_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "parameter": {
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/configurationValue"
        },
        "comparison": {
          "enum": [
            "exact",
            "canonical_routes"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "required": [
        "type",
        "target"
      ]
    },
    "parameter": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "default", "label", "policy", "section"],
      "properties": {
        "type": {"enum": ["enum", "integer", "number", "boolean", "text"]},
        "default": {"type": ["string", "integer", "number", "boolean"]},
        "label": {"type": "string"},
        "policy": {"enum": ["editable", "fixed", "config_file_only", "reported"]},
        "section": {"type": "string"},
        "legacy_key": {"type": "string"},
        "choices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/choice"}},
        "minimum": {"type": "number"}, "maximum": {"type": "number"},
        "step": {"type": "number", "exclusiveMinimum": 0},
        "display_scale": {"type": "number", "exclusiveMinimum": 0},
        "display_unit": {"type": "string"}, "decimals": {"type": "integer", "minimum": 0},
        "tooltip": {"type": "string"}, "visible": {"type": "boolean"},
        "order": {"type": "integer"}, "command": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "enum"}}}, "then": {"required": ["choices"]}},
        {"if": {"properties": {"type": {"const": "integer"}}}, "then": {"properties": {"default": {"type": "integer"}}}},
        {"if": {"properties": {"type": {"const": "boolean"}}}, "then": {"properties": {"default": {"type": "boolean"}}}}
      ]
    },
    "choice": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "wire_value"],
      "properties": {
        "id": {"type": ["string", "integer"]}, "label": {"type": "string"},
        "wire_value": {"type": ["string", "number", "boolean"]},
        "full_scale_volts": {"type": "number", "exclusiveMinimum": 0},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": ["string", "integer"]}}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["when"],
      "properties": {
        "when": {"type": "object", "additionalProperties": false, "required": ["parameter", "equals"], "properties": {"parameter": {"type": "string"}, "equals": {"type": ["string", "number", "boolean"]}}},
        "force": {"type": "object"}, "effective": {"type": "object"},
        "enabled": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "visible": {"type": "object", "additionalProperties": {"type": "boolean"}}
      }
    }
  }
}
