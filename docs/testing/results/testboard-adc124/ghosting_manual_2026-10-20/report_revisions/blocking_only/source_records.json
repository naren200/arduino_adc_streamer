  "blocks": [
    {
      "kind": "paragraph",
      "text": "Ghosting Tests – TestBoard_ADC124:"
    },
    {
      "kind": "paragraph",
      "text": "Manual ghosting test: "
    },
    {
      "kind": "paragraph",
      "text": "Method: Press each TOP sensor and look for ghosting on the adjacent sensor in Octo-7, which is spread across 4 MUXs. (only 1 full octo per MUX + partial octo-7)"
    },
    {
      "kind": "table",
      "table": 0,
      "rows": [
        [
          "Array",
          "MUX (resistor value)",
          "Channel pressed",
          "Channel tested"
        ],
        [
          "1",
          "1 470K)",
          "PZT1_T (ch4)",
          "PZT7_B (ch5)"
        ],
        [
          "1",
          "2 (1M)",
          "PZT3_T (ch4)",
          "PZT7_ L (ch5)"
        ],
        [
          "1",
          "3 (470K)",
          "PZT5_T (ch4)",
          "PZT7_C (ch5)"
        ],
        [
          "1",
          "4 (1M)",
          "PZT6_T (ch4)",
          "PZT7_R (ch5), T(ch6)"
        ],
        [
          "2",
          "1 (1M)",
          "PZT1_T (ch4)",
          "PZT7_B (ch5)"
        ],
        [
          "2",
          "2 (470K)",
          "PZT3_T (ch4)",
          "PZT7_ L (ch5)"
        ],
        [
          "2",
          "3 (1M)",
